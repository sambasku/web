{
  "name": "sambasku-web",
  "version": "0.1.0",
  "description": "Public web and vocabulary search for Kamus Digital Sambas-Indonesia",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:staging": "react-router build --mode staging",
    "preview": "react-router dev",
    "typecheck": "react-router typegen && tsc -b",
    "test": "node --experimental-strip-types --test \"app/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@mantine/code-highlight": "9.6.2",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@react-router/cloudflare": "^8.5.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.4",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
